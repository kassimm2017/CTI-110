import turtle

# Set up window
win = turtle.Screen()
win.bgcolor("lightblue")
win.title("P4LAB1 - Ayinga Kassim Mohammed")

t = turtle.Turtle()
t.pensize(3)

# Draw Square - using a FOR loop (4 sides)
for i in range(4):
    t.forward(100)
    t.left(90)

# Move to new position for triangle
t.penup()
t.forward(150)
t.pendown()

# Draw Triangle - using a FOR loop (3 sides)
for i in range(3):
    t.forward(100)
    t.left(120)

win.mainloop()
